  "keyFeatures": [
    "Plugin system for extending server functionality with custom C# plugins",
    "Extensible command framework for adding custom slash commands",
    "Event system with priority-based handlers (PlayerChat, PlayerMove, PlayerConnect, etc.)",
    "Rank-based permission system with fully configurable groups",
    "World/level management with physics, zones, and access controls",
    "Built-in mini-games: Zombie Survival, CTF, Lava Survival, TNT Wars, Countdown",
    "Economy system with configurable shop items and currency",
    "AI bots with programmable behavior instructions",
    "Discord and IRC relay integration",
    "BlockDB block change tracking and undo system",
    "Map generation with multiple terrain styles and biomes",
    "Overseer realms for per-player personal worlds",
    "CPE (Classic Protocol Extension) support for enhanced client features",
    "SQLite and MySQL database backends"
  ],
  "publicApiSurface": [
    "Plugin (abstract class) — Load(), Unload(), Help(Player p)",
    "Command / Command2 (abstract class) — Use(Player p, string message), Help(Player p)",
    "IEvent<T>.Register(method, priority) / IEvent<T>.Unregister(method)",
    "OnPlayerChatEvent, OnPlayerMoveEvent, OnPlayerCommandEvent, OnPlayerConnectEvent",
    "OnLevelLoadedEvent, OnLevelUnloadEvent, OnLevelSaveEvent",
    "OnServerShutdownEvent, OnModActionEvent",
    "Player.Message(string), Player.SendBlockchange(...), Player.DefaultCmdData",
    "Level.SetBlock(...), Level.GetBlock(...), Level.Config",
    "Group.GroupList, Group.Find(LevelPermission)",
    "Server.Config (ServerConfig properties)",
    "IScripting.COMMANDS_DLL_DIR, IScripting.PLUGINS_DLL_DIR",
    "Command.Register(Command), Command.Unregister(Command), Command.Find(string)",
    "CommandPerms, CommandExtraPerms",
    "Database.Execute(...), Database.ReadRows(...)"
  ]
